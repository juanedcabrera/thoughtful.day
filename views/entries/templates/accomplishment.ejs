
<div class="entry-form-container">
  <form method="POST" action="/entries">
    <input type="hidden" name="selectedTemplate" value="<%= selectedTemplate %>">

    <div class="centered">
      <h1>📝</h1>
      <div class="mb-3">
        <label for="content1" class="form-label">What did I accomplish?</label>
        <textarea class="form-control" type="text" id="content1" rows="3" name="content1" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content2" class="form-label">What is the impact that this item had for me and/or my team?</label>
        <textarea class="form-control" type="text" id="content2" rows="3" name="content2" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content3" class="form-label">What is the impact that this item had on the organization?</label>
        <textarea class="form-control" type="text" id="content3" rows="3" name="content3" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content4" class="form-label">Who helped you in achieving this accomplishment?</label>
        <textarea class="form-control" type="text" id="content4" rows="3" name="content4" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content5" class="form-label">What did you learn?</label>
        <textarea class="form-control" type="text" id="content5" rows="3" name="content5" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content6" class="form-label">How will you take this further?</label>
        <textarea class="form-control" type="text" id="content6" rows="3" name="content6" required maxlength="2100"></textarea>
      </div>
      <h4>Tags:</h4>
    </div>

    <div class="tag-grid">
      <%
      for (let i = adjectives.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [adjectives[i], adjectives[j]] = [adjectives[j], adjectives[i]];
      }
      for (const adj of adjectives) { %>
        <div class="tag-chip">
          <input type="checkbox" id="tag-<%= adj.name.toLowerCase() %>" name="tags" value="<%= adj.name.toLowerCase() %>">
          <label for="tag-<%= adj.name.toLowerCase() %>"><%= adj.name %></label>
        </div>
      <% } %>
    </div>

    <div class="centered">
      <button class="button" type="submit">Save Entry</button>
    </div>
  </form>
</div>
