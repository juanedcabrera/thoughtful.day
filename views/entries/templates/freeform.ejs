
<div class="entry-form-container">
  <form method="POST" action="/entries">
    <input type="hidden" name="selectedTemplate" value="<%= selectedTemplate %>">

    <div class="centered">
      <h1>📝</h1>
      <div class="mb-3">
        <label for="content1" class="form-label">What happened today?</label>
        <textarea class="form-control" type="text" id="content1" rows="3" name="content1" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content2" class="form-label">Any thoughts you want to record?</label>
        <textarea class="form-control" type="text" id="content2" rows="3" name="content2" required maxlength="2100"></textarea>
      </div>
      <div class="mb-3">
        <label for="content3" class="form-label">How are you feeling?</label>
        <textarea class="form-control" type="text" id="content3" rows="3" name="content3" required maxlength="2100"></textarea>
      </div>
      <h4>Tags:</h4>
    </div>

    <div class="tag-grid">
      <%
      for (let i = adjectives.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [adjectives[i], adjectives[j]] = [adjectives[j], adjectives[i]];
      }
      for (const adj of adjectives) { %>
        <div class="tag-chip">
          <input type="checkbox" id="tag-<%= adj.name.toLowerCase() %>" name="tags" value="<%= adj.name.toLowerCase() %>">
          <label for="tag-<%= adj.name.toLowerCase() %>"><%= adj.name %></label>
        </div>
      <% } %>
    </div>

    <div class="centered">
      <button class="button" type="submit">Save Entry</button>
    </div>
  </form>
</div>
