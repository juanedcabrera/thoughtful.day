<%- include("../partials/header.ejs")%>

<div class="page-wrapper">
  <h2 class="centered">Journal Entries</h2>

  <form action="/entries" method="GET">
    <div class="row g-3">
      <div class="col-md-6 col-lg-3">
        <label for="word" class="form-label">Word:</label>
        <input type="text" id="word" name="word" class="form-control" placeholder="Word in your entry">
      </div>
      <div class="col-md-6 col-lg-3">
        <label for="tag" class="form-label">Tag:</label>
        <input type="text" id="tag" name="tag" class="form-control" placeholder="Tag in your entry">
      </div>
      <div class="col-md-6 col-lg-3">
        <label for="type" class="form-label">Type:</label>
        <input type="text" id="type" name="type" class="form-control" placeholder="Template name">
      </div>
      <div class="col-md-6 col-lg-3">
        <label for="date" class="form-label">Date:</label>
        <input type="date" id="date" name="date" class="form-control" placeholder="Date of your entry">
      </div>
    </div>
    <button type="submit" class="button mt-3">Search</button>
  </form>

  <div class="card-deck mt-4">
    <% for (const entry of entries) {
      const createdAt = new Date(entry.createdAt);
      const options = {
        weekday: 'long',
        month: 'long',
        day: 'numeric'
      };
      const dateString = createdAt.toLocaleDateString('en-US', options);
      const hour = createdAt.getHours();
      const greeting = hour < 12 ? 'Morning' : 'Evening';
    %>
      <div class="card mb-4">
        <div class="card-header"><a href="/entries/<%= entry.id %>"><%= dateString %> <%= greeting %></a></div>
        <div class="card-body">
          <p class="card-text"><%= entry.content.content1 %></p>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include("../partials/footer.ejs") %>
